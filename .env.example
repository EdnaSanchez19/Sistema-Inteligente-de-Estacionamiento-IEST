# --- Base de datos ---
POSTGRES_USER=estacionamiento
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=estacionamiento
# Desde tu máquina usa localhost; dentro de docker compose el host es "db"
DATABASE_URL=postgresql+psycopg://estacionamiento:cambia_esta_contrasena@localhost:5432/estacionamiento

# --- API ---
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia_este_secreto
JWT_EXPIRE_MINUTES=480
# Clave que usa el servidor de visión para publicar resultados en la API
INGEST_API_KEY=cambia_esta_clave

# --- Visión ---
API_URL=http://localhost:8000
CAMERAS_CONFIG=vision/config/cameras.json
YOLO_MODEL=yolov8n.pt
